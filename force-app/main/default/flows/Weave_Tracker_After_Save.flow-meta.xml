<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Weave_Data</name>
        <label>Assign Weave Data</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Get_Practice.Weave_Start_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>GoLiveDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_Practice.Weave_Do_Not_Create_FF__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.PSR_Stop_FF__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Practice</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Valid_Record</name>
        <label>Valid Record?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_ValidDate</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PracticeId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GoLiveDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Practice</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Flow that updates the Weave Go Live in a practice record when Weave Tracker is imported.</description>
    <environments>Default</environments>
    <formulas>
        <name>GoLiveDate</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!$Record.Live_Date__c})</expression>
    </formulas>
    <formulas>
        <name>PracticeId</name>
        <dataType>String</dataType>
        <expression>IF(
  ISBLANK({!$Record.Practice_ID__c}),
  &quot;00000&quot;,
  LPAD({!$Record.Practice_ID__c}, 5, &quot;0&quot;)
)</expression>
    </formulas>
    <interviewLabel>Weave Tracker - After Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Weave Tracker - After Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Practice</name>
        <label>Get Practice</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Weave_Data</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Location_ID_5_digit__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>PracticeId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Practice</name>
        <label>Update Practice</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Weave_Tracker</targetReference>
        </connector>
        <inputReference>Get_Practice</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Weave_Tracker</name>
        <label>Update Weave Tracker</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Practice__c</field>
            <value>
                <elementReference>Get_Practice.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Valid_Record</targetReference>
        </connector>
        <object>Weave_Tracker__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
