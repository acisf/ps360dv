<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_survey_email</name>
        <label>Send survey email</label>
        <locationX>165</locationX>
        <locationY>998</locationY>
        <actionName>Case.Feedback_Survey_emailed_to_Customer_when_case_is_closed</actionName>
        <actionType>emailAlert</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Case.Feedback_Survey_emailed_to_Customer_when_case_is_closed</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>53.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>This decision checks for the contact email and the vendor accounts. We won&apos;t send surveys if a contact email is missing or the contact is a vendor</description>
        <name>Is_contact_not_null</name>
        <label>Is contact not null or Vendor?</label>
        <locationX>451</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_contact_not_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_the_case_record.Contact.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_the_case_record.Contact.RecordType.Id</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>0121R000000oKOWQA2</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Survey</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_the_case_an_Insurance_Compliance_one</name>
        <label>Is the case an Insurance &amp; Compliance one?</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Is_contact_not_null</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Case_is_an_insurance_Compliance</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_the_case_record.Team__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Insurance Services</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_the_case_record.Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Compliance and Auditing</stringValue>
                </rightValue>
            </conditions>
            <label>Yes Case is an insurance &amp; Compliance</label>
        </rules>
    </decisions>
    <decisions>
        <name>SurveySentPercentage_Expected_Percentage</name>
        <label>SurveySentPercentage &lt;= Expected Percentage</label>
        <locationX>297</locationX>
        <locationY>674</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SurveySentPercentage</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Setup.SurveyCounters__c.Survey_sent_percentage__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_survey_sent_count</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Version upgrade to create a Survey Statistic record
Upgrade- Re: avoid running the flow if the case is an Insurance &amp; Compliance</description>
    <environments>Default</environments>
    <formulas>
        <name>SurveySentPercentage</name>
        <dataType>Number</dataType>
        <expression>(({!$Setup.SurveyCounters__c.Total_surveys_sent__c} + 1)/ {!$Setup.SurveyCounters__c.Total_resolved_cases__c}) * 100</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>TotalResolvedCases</name>
        <dataType>Number</dataType>
        <expression>{!$Setup.SurveyCounters__c.Total_resolved_cases__c} + 1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>TotalSurveys</name>
        <dataType>Number</dataType>
        <expression>{!$Setup.SurveyCounters__c.Total_surveys_sent__c} + 1</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Survey Flow {!$Flow.CurrentDateTime}</interviewLabel>
