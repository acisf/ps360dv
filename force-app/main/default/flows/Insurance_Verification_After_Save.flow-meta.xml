    <description>4/28/26 - Added 4 Successful and 2 Failed status values per LW
6/16 - Adding appt time
Desc: This flow creates a case for unique records or updates existing cases based on records added to the Insurance_Verification__c object from an EDW data feed</description>
    <environments>Default</environments>
    <formulas>
        <name>DateChanged</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.Appointment_Date__c})</expression>
    </formulas>
    <formulas>
        <name>DateDiff</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Appointment_Date__c}   -  {!Get_Case_by_Appt_Id.Appointment_Date__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>DescriptionNote</name>
        <dataType>String</dataType>
        <expression>{!Get_Case_by_Appt_Id.Description} + BR() + TEXT(NOW()) + BR() + &quot;Appointment date changed.&quot;</expression>
    </formulas>
    <formulas>
        <name>DescriptionNote2</name>
        <dataType>String</dataType>
        <expression>{!Get_Case_by_Appt_Id.Description} + BR() + TEXT(NOW()) + BR() + &quot;Appointment date changed and case reopened.&quot;</expression>
    </formulas>
    <formulas>
        <name>OptinDatePlusTwo</name>
        <dataType>Date</dataType>
        <expression>{!Get_Practice.Insurance_Verification_Opt_in_Date__c} + 2</expression>
    </formulas>
    <formulas>
        <name>varSubject</name>
        <dataType>String</dataType>
        <expression>{!$Record.Type__c} &amp; &quot; - &quot; &amp; &quot;Location &quot; &amp;  {!$Record.Location_Id__c}</expression>
    </formulas>
