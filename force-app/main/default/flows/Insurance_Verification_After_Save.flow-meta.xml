            <conditionLogic>(1 AND 2 AND 3) OR (4 AND 5 AND 6 AND (7 OR 8 OR 9 OR 10 OR 11 OR 12 OR 13 OR 14) )</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_by_Appt_Id.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Scheduled Review</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>DateDiff</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>10.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case_by_Appt_Id.IsClosed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case_by_Appt_Id.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Scheduled Review</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>DateChanged</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case_by_Appt_Id.IsClosed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case_by_Appt_Id.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>No insurance information available</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case_by_Appt_Id.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Patient Rescheduled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case_by_Appt_Id.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Successful - on time</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case_by_Appt_Id.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Successful - late (Office replied late)</stringValue>
                </rightValue>
            </conditions>
            <conditions>
