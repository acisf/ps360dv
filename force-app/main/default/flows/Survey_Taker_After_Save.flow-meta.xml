    <formulas>
        <name>Emailformula</name>
        <dataType>String</dataType>
        <expression>&quot;Hello,&quot; + 
&quot;&lt;br/&gt;&lt;br/&gt;&quot; +
&quot;We have received a No survey response to the Question &apos;Did we solve the Problem?&apos; Here are the details:&quot; + 
&quot;&lt;br/&gt;&quot; +
&quot;&lt;strong&gt;Survey Taker:&lt;/strong&gt; &lt;a href=&apos;https://affordablecare.lightning.force.com/lightning/r/SurveyTaker__c/&quot; + {!$Record.Id}+ &quot;/view&apos;&gt;View Survey Taker&lt;/a&gt;&quot; + 
&quot;&lt;br/&gt;&quot; +
&quot;&lt;strong&gt;Case:&lt;/strong&gt; &lt;a href=&apos;https://affordablecare.lightning.force.com/lightning/r/Case/&quot; + {!$Record.Case__r.Id} + &quot;/view&apos;&gt;View Case&lt;/a&gt;&quot; + 
&quot;&lt;br/&gt;&quot; +
&quot;Thank you.&quot;</expression>
    </formulas>
    <formulas>
        <name>Manageremail</name>
        <dataType>String</dataType>
        <expression>IF(
    {!$Record.Case_Team__c} = &quot;IT&quot;,
    &quot;Enrique.Seward@affordablecare.com&quot; &amp; 
    IF(
        ISBLANK({!Get_Case_owner_manager.Manager.Email}), 
        &quot;&quot;, 
        &quot;,&quot; &amp; {!Get_Case_owner_manager.Manager.Email}
    ),
    {!Get_Case_owner_manager.Manager.Email}
)</expression>
    </formulas>
