<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Practice_On_Weave</name>
        <label>Practice On Weave?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Status_Not_On_Weave</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Weave</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Practice_On_Weave__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Intake_Queue_New</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>11/10 Update Last Intake Date on Contact
10/20 Owner is queue on create
10/17 Created</description>
    <environments>Default</environments>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>Patient Intake - After Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Patient Intake - After Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
