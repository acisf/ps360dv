<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Names</name>
        <label>Assign Names</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignmentItems>
            <assignToReference>firstName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>firstNameFormula</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>firstAndMiddlesName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>firstAndMiddleNameFormula</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>lastName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>lastNameFormula</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <name>firstAndMiddleNameFormula</name>
        <dataType>String</dataType>
        <expression>LEFT( {!fullNameInput}, LEN({!fullNameInput}) - (FIND(&quot; &quot;, REVERSE({!fullNameInput})) - 1))</expression>
    </formulas>
    <formulas>
        <name>firstNameFormula</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK(LEFT( {!fullNameInput}, (FIND(&quot; &quot;, {!fullNameInput})))) , {!fullNameInput} , LEFT( {!fullNameInput}, (FIND(&quot; &quot;, {!fullNameInput}))))</expression>
    </formulas>
    <formulas>
        <name>lastNameFormula</name>
        <dataType>String</dataType>
        <expression>RIGHT( {!fullNameInput}, FIND(&quot; &quot;, REVERSE({!fullNameInput})))</expression>
    </formulas>
    <interviewLabel>AdiBot - Return Names {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AdiBot - Return Names</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Assign_Names</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>firstAndMiddlesName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>firstName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>fullNameInput</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>lastName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
