<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_if_practice_exists</name>
        <label>Check if practice exists</label>
        <locationX>182</locationX>
        <locationY>395</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Practice_exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Practice_ID.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_practice_fees</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>4/17 Looks up SF Practice Id based on Location_Id</description>
    <environments>Default</environments>
    <formulas>
        <name>Standardized_location_id</name>
        <dataType>String</dataType>
        <expression>RIGHT(&quot;00000&quot; &amp; {!$Record.Location_Id__c}, 5)</expression>
    </formulas>
    <interviewLabel>Practice Fee -- Before Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Practice Fee -- Before Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Practice_ID</name>
        <label>Get Practice ID</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_if_practice_exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Location_ID_5_digit__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Standardized_location_id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_practice_fees</name>
        <label>Update practice fees</label>
        <locationX>50</locationX>
        <locationY>503</locationY>
        <inputAssignments>
            <field>Practice__c</field>
            <value>
                <elementReference>Get_Practice_ID.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Practice_ID</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Location_Id__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Practice_Fee__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
