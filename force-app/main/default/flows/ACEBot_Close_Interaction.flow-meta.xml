    <description>Closes an ACE_Bot_Interaction__c record by writing the outcome, resolution flag, issue summary, and closed timestamp. Called by GeneralFAQ and Create_Case subagents on every terminal interaction state.</description>
    <environments>Default</environments>
    <formulas>
        <name>outcomeToStatus</name>
        <dataType>String</dataType>
        <expression>IF({!outcome} = &quot;Abandoned&quot;, &quot;Abandoned&quot;, &quot;Resolved&quot;)</expression>
    </formulas>
    <interviewLabel>ACEBot Close Interaction {!$Flow.CurrentDateTime}</interviewLabel>
