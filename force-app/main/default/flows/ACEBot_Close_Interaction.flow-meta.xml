    <decisions>
        <description>This drives whether Case__c and Case_Created__c get written.</description>
        <name>Was_a_Case_ID_provided</name>
        <label>Was a Case ID provided</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
