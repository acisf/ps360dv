    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Contact_to_Collection</name>
        <label>Add Contact to Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>ADGroupMatchedContactCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>ADGroupMemberRecord</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>MatchedContacts</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Assign_Contact_to_AD_Group_Member</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Pratices</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_AD_Group_Member_to_Variable</name>
        <label>Assign AD Group Member to Variable</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>ADGroupMemberRecord</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Contact</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Contact</name>
        <label>Assign Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>ADGroupMemberRecord.Contact__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Assign_Contact_to_AD_Group_Member.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Pratices</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Practice_and_Vendor_RT</name>
        <label>Assign Practice and Vendor RT</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Assign_Contact_to_AD_Group_Member.AccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Pratices.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Assign_Contact_to_AD_Group_Member.RecordTypeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>0121R000000oKOWQA2</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_Contact_to_Collection</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Do_Contact_and_Practice_Exist</name>
        <label>Do Contact and Practice Exist?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Records_2</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contacts</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Practices</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Contact_to_AD_Group_Member</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Does_Practice_name_match_Vendor_Group</name>
        <label>Does Practice name match Vendor Group?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Pratices</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Pratices.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>TrimVendorGroup</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Practice_and_Vendor_RT</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>1/12/26 Updated Dept to does not equal &quot;007-ACI-Info Technology&quot;
Added nested loop for account</description>
    <environments>Default</environments>
    <formulas>
        <name>TrimVendorGroup</name>
        <dataType>String</dataType>
        <expression>TRIM(SUBSTITUTE(
  SUBSTITUTE(
    SUBSTITUTE({!$Record.Group__c}, &quot;Vendor-&quot;, &quot;&quot;),
    &quot;Vendor -&quot;, &quot;&quot;),
  &quot;Vendor - &quot;, &quot;&quot;)
)</expression>
    </formulas>
    <interviewLabel>AD Vendor Group - After Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AD Vendor Group - After Save</label>
    <loops>
        <name>Assign_Contact_to_AD_Group_Member</name>
        <label>Assign Contact to AD Group Member</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Contacts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_AD_Group_Member_to_Variable</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Records_2</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Pratices</name>
        <label>Pratices</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Practices</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Does_Practice_name_match_Vendor_Group</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Assign_Contact_to_AD_Group_Member</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get only the contacts that correspond to the AD Group Member record</description>
        <name>Get_Contacts</name>
        <label>Get Contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Do_Contact_and_Practice_Exist</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Email__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Location_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Location_Id__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Department</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>007-ACI-Info Technology</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Practices</name>
        <label>Get Practices</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Contacts</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>TrimVendorGroup</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Contacts</name>
        <label>Update Contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>MatchedContacts</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Records_2</name>
        <label>Update AD Group Member</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Contacts</targetReference>
        </connector>
        <inputReference>ADGroupMatchedContactCollection</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Practices</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Group__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>Vendor</stringValue>
            </value>
        </filters>
        <object>AD_Group_Member__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
