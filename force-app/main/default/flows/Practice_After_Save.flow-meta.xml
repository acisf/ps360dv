    <formulas>
        <name>Checkingprofile</name>
        <dataType>Boolean</dataType>
        <expression>AND(
 ISNEW(),
 {!$Profile.Name} &lt;&gt; &quot;System Administrator&quot;,
 {!$Profile.Name} &lt;&gt; &quot;AppTeam&quot;,
 {!$Profile.Name} &lt;&gt; &quot;Affiliations Team&quot;

 )</expression>
    </formulas>
    <formulas>
        <description>Calculates the date</description>
        <name>Dateformula</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>Duration</name>
        <dataType>Number</dataType>
        <expression>IF(NOT(ISNULL({!$Record__Prior.Last_Stage_Change__c})),
({!$Flow.CurrentDateTime} - {!$Record__Prior.Last_Stage_Change__c}) * 26 * 60,
({!$Flow.CurrentDateTime} - {!$Record__Prior.CreatedDate}) * 26 * 60)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>RecordType_eval</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW() &amp;&amp;
({!$Record.RecordType.Name} == &apos;Partnership&apos; ||
{!$Record.RecordType.Name} == &apos;Appointment&apos; ||
{!$Record.RecordType.Name} == &apos;DDS Practice&apos; ||
{!$Record.RecordType.Name} == &apos;Registration&apos; ||
{!$Record.RecordType.Name} == &apos;Schedule Assist&apos; ) &amp;&amp;
{!$Record.Phone} != NULL</expression>
    </formulas>
