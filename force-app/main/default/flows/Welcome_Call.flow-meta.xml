    <textTemplates>
        <name>Appt_Date_Time_Confirm</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;“Mrs./Mr. {!Get_Case.Patients_Last_Name__c}, I am giving you a call to make sure you are all set for your upcoming appointment at our &lt;/span&gt;&lt;strong style=&quot;font-size: 18px;&quot;&gt;{!Get_Case.Account.Name}&lt;/strong&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt; practice. I am showing that your appointment is &lt;/span&gt;&lt;strong style=&quot;font-size: 18px;&quot;&gt;{!Get_Case.AppointmentDateTime__c}&lt;/strong&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;. Is that correct?”&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>Budget_Confirm</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;“We offer treatment plans to fit everyone’s needs and budgets. Do you have a budget in mind?&amp;nbsp;I can note this and add details such as being interested in financing…”&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;“Awesome, I have noted this on your appointment. Mrs./Mr. {!Get_Case.Patients_Last_Name__c}, please bring anyone with you that can support you while you make your financial and medical decisions.”&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>Insurance_Confirmation</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;“We are almost finished prepping you for your appointment Mr./Mrs. {!Get_Case.Patients_Last_Name__c}. For insurance, I am showing that you have...&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;[&lt;/span&gt;&lt;em style=&quot;font-size: 18px;&quot;&gt;AGENT: In Dentrix, confirm insurance details]&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;Insurance Provider: &lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;Subscriber Name and DOB: &lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;Relationship to Subscriber (if applicable): &lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;Subscriber ID # - Member ID #: &lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;Subscriber Employer: &lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;Group Number:&quot;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>Services_Confirm</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;“I am showing that you would like to speak to the &lt;/span&gt;&lt;strong style=&quot;font-size: 18px;&quot;&gt;{!Get_Case.Account.Name}&lt;/strong&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt; team about...&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;[&lt;/span&gt;&lt;em style=&quot;font-size: 18px;&quot;&gt;AGENT: From Dentrix, list services, and update if needed&lt;/em&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;]. &lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;Please bring in a list of your allergies, OTC and prescribed medications. Is there anything else you would like me to notate?&lt;/span&gt;&lt;strong style=&quot;font-size: 18px;&quot;&gt;”&lt;/strong&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>TestBody</name>
