    <textTemplates>
        <name>Voicemail</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 18px;&quot;&gt;“Hi! This is {!$User.FirstName} from Affordable Dentures and Implants &lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 18px; color: rgb(36, 36, 36); font-family: Aptos, sans-serif;&quot;&gt;calling regarding your appointment at our {!Get_Case.Account.Name} practice. Please give us a call back today at&amp;nbsp;&lt;/span&gt;&lt;strong style=&quot;background-color: rgb(255, 255, 255); font-size: 18px; color: rgb(36, 36, 36); font-family: Aptos, sans-serif;&quot;&gt;1-&lt;/strong&gt;&lt;strong style=&quot;font-size: 18px;&quot;&gt;866-807-0197&lt;/strong&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;. We &lt;/span&gt;&lt;span style=&quot;font-size: 18px; background-color: rgb(255, 255, 255); color: rgb(36, 36, 36); font-family: Aptos, sans-serif;&quot;&gt;are open from 7:00am-9:00pm Eastern Time.&lt;/span&gt;&lt;strong style=&quot;font-size: 18px; background-color: rgb(255, 255, 255); color: rgb(36, 36, 36); font-family: Aptos, sans-serif;&quot;&gt;&amp;nbsp;&lt;/strong&gt;&lt;span style=&quot;font-size: 18px; background-color: rgb(255, 255, 255); color: rgb(36, 36, 36); font-family: Aptos, sans-serif;&quot;&gt;Thank you!&lt;/span&gt;&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>Welcome_Call_Intro</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;“Hi! This is &lt;/span&gt;&lt;span style=&quot;font-size: 18px; background-color: rgb(255, 255, 255);&quot;&gt;{!$User.FirstName}&lt;/span&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt; from Affordable Dentures and Implants. May I speak to Mrs./Mr. {!Get_Case.Patients_Last_Name__c}?”&lt;/span&gt;&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>Wrap_Up</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;﻿“I appreciate your time today, Mr./Mrs. {!Get_Case.Patients_Last_Name__c}.&amp;nbsp;Have you completed your new patient paperwork?&quot;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;[&lt;/span&gt;&lt;em style=&quot;font-size: 18px;&quot;&gt;Agent: If they have not completed new patient paperwork&lt;/em&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;]  &lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&quot;I will send your new patient paperwork; would you prefer it via email or text? Your new patient paperwork will ask you to confirm your insurance again to ensure you are all set for your appointment. We ask that paperwork is completed prior to your appointment date. This information is needed before you are seen in office.”&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;“If you have any questions, please give us a call at 1-800-denture. Is there anything else I can note on your appointment for you?”&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;“Thank you for choosing Affordable Dentures and Implants. Have an amazing day!”&lt;/span&gt;&lt;/p&gt;</text>
