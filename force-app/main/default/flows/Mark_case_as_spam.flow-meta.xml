    <description>09/25/24 Added check to pass validation for Web: Appt Request
10/10/23 Add confirmation screen to blacklist email
10/4/23 Reverted
10/4/23 Removed email__c ref
8/10/23 - Removed record type check
Marks the case as spam, resolves the case and assigns RT Web:SPAM. Captures the web email to add to blacklist addresses.</description>
    <environments>Default</environments>
    <formulas>
        <description>Is the link in the description?</description>
        <name>Link_Detected</name>
        <dataType>Boolean</dataType>
        <expression>OR(
    CONTAINS({!Get_Case_Record.Description}, &quot;http://&quot;),
    CONTAINS({!Get_Case_Record.Description}, &quot;https://&quot;),
    CONTAINS({!Get_Case_Record.Description}, &quot;www.&quot;)
)</expression>
    </formulas>
    <formulas>
        <name>newSubject</name>
        <dataType>String</dataType>
        <expression>If(CONTAINS({!caseSubject}, &apos;JUNK&apos;),{!caseSubject},&apos;JUNK &apos; + {!caseSubject})</expression>
    </formulas>
    <formulas>
        <name>PhoneNumberIsValid</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    NOT(ISBLANK({!Get_Case_Record.SuppliedPhone})), 
    LEN({!Get_Case_Record.SuppliedPhone}) = 10      
)</expression>
    </formulas>
    <formulas>
        <description>This formula Strips out links in the description links.</description>
        <name>StripDescriptionLinks</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(
    SUBSTITUTE(
        SUBSTITUTE(
            SUBSTITUTE(
                SUBSTITUTE(
                    SUBSTITUTE(
                        SUBSTITUTE(
                            SUBSTITUTE(
                                {!Get_Case_Record.Description},
                                &quot;http://&quot;, &quot;&quot;),
                            &quot;https://&quot;, &quot;&quot;),
                        &quot;www.&quot;, &quot;&quot;),
                    &quot;.com&quot;, &quot;&quot;),
                &quot;.org&quot;, &quot;&quot;),
            &quot;.net&quot;, &quot;&quot;),
        &quot;.edu&quot;, &quot;&quot;),
    &quot; &quot;, &quot;&quot;)</expression>
    </formulas>
