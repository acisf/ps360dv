    <formulas>
        <name>LastWeek</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} - ((Weekday({!$Flow.CurrentDate})) + 6)</expression>
    </formulas>
    <formulas>
        <name>ThisMonth</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} - (DAY({!$Flow.CurrentDate}) - 1)</expression>
    </formulas>
    <formulas>
        <name>ThisWeek</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} - ((Weekday({!$Flow.CurrentDate})) - 1)</expression>
    </formulas>
