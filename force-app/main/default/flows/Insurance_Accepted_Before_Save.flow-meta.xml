    <decisions>
        <name>Valid_Location</name>
        <label>Valid Location?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Nullify_Practice_InvalidLoc</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_validLocation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>normalizedLocationId</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>normalizedLocationId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>0</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>normalizedLocationId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>00000</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Practice</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>isActive</name>
        <dataType>Boolean</dataType>
        <expression>IF(
OR(
{!$Record.INACTIVATE_PLAN_TERMED_DOC__c}= TRUE,
{!$Record.Insurance_Plan__c}= &quot;#NO MATCH&quot;
),
FALSE,
OR(
{!$Record.Good_News_Not_Required_ONLY_HALEY__c}= TRUE,
{!$Record.Initiate_Good_News_Email_ELIZABETH_OR_H__c}= TRUE,
{!$Record.GN_Portal_Requires_Site_Assistance_EP__c}= TRUE
)
)</expression>
    </formulas>
    <formulas>
        <name>normalizedLocationId</name>
        <dataType>String</dataType>
        <expression>IF(
  ISBLANK({!$Record.Location_Id__c}),
  &quot;&quot;,
  IF(
    LEN(TRIM({!$Record.Location_Id__c})) = 4,
    &quot;0&quot; &amp; TRIM({!$Record.Location_Id__c}),
    TRIM({!$Record.Location_Id__c})
  )
)</expression>
    </formulas>
    <interviewLabel>Insurance Accepted - Before Save {!$Flow.CurrentDateTime}</interviewLabel>
