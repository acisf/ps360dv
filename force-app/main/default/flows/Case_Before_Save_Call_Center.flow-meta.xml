    <formulas>
        <name>AdjustedNextContactTimeUTC</name>
        <dataType>DateTime</dataType>
        <expression>{!InitialNextContactTime} - ({!UTCOffsetSeconds} / 86400)</expression>
    </formulas>
    <formulas>
        <name>AdjustedSpecialDateNextCallTimeUTC_8_15</name>
        <dataType>DateTime</dataType>
        <expression>{!SpecialDateNextCallTimeUTC_Base_8_15} - ({!UTCOffsetSeconds} / 86400)</expression>
    </formulas>
    <formulas>
        <name>AdjustedSpecialDateNextCallTimeUTC_8_8</name>
        <dataType>DateTime</dataType>
        <expression>{!SpecialDateNextCallTimeUTC_Base_8_8} - ({!UTCOffsetSeconds} / 86400)</expression>
    </formulas>
    <formulas>
        <name>CheckStatus1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  OR(
    {!TEXT($Record.Status)} = &quot;Third Attempt&quot;,
    {!TEXT($Record.Status)} = &quot;Fourth Attempt&quot;
  ),
  {!$Flow.CurrentDate} &lt; DATE(2024, 8, 8)
)</expression>
    </formulas>
    <formulas>
        <name>CheckStatus2</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  OR(
    {!TEXT($Record.Status)} = &quot;Fifth Attempt&quot;,
    {!TEXT($Record.Status)} = &quot;Sixth Attempt&quot;,
    {!TEXT($Record.Status)} = &quot;Seventh Attempt&quot;
  ),
  {!$Flow.CurrentDate} &lt; DATE(2024, 8, 15) 
)</expression>
    </formulas>
    <formulas>
        <name>InitialNextContactTime</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE( TEXT({!$Flow.CurrentDate} + 1) + &quot; 09:00:00&quot;)</expression>
    </formulas>
    <formulas>
        <name>SpecialDateNextCallTimeUTC_Base_8_15</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(&quot;2024-08-15 14:00:00&quot;)</expression>
    </formulas>
    <formulas>
        <name>SpecialDateNextCallTimeUTC_Base_8_8</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(&quot;2024-08-08 14:00:00&quot;)</expression>
    </formulas>
    <formulas>
        <name>UTCOffsetSeconds</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Contact.Account.Time_UTCOffset__c} + {!$Record.Contact.Account.Time_DSTOffset__c}</expression>
